<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Shared by Visual C++ projects beneath this directory. -->
  <ItemDefinitionGroup Condition="'$(MSBuildProjectExtension)' == '.vcxproj'">
    <ClCompile>
      <AdditionalOptions>%(AdditionalOptions) /utf-8</AdditionalOptions>
      <ForcedIncludeFiles>$(MSBuildThisFileDirectory)CppConsoleUtf8.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
